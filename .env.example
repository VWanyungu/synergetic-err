# Environment (development | staging | production)
# Must be "production" on the VPS: that is what switches file uploads from Cloudinary to Cloudflare R2.
NODE_ENV=development

# Database Configuration
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=err-syn

# ---------------------------------------------------------
# Cache: Upstash (Dev / Staging) vs Local Redis (Production)
# ---------------------------------------------------------

# Production: Local Redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PASSWORD=

# Development / Staging: Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------
# Storage: Cloudinary (Dev / Staging) vs Cloudflare R2 (Production)
# ---------------------------------------------------------

# Development / Staging: Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Production: Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME is private: attachments, opened through short-lived signed links.
R2_BUCKET_NAME=
# R2_PUBLIC_BUCKET_NAME is public, served from R2_PUBLIC_URL: profile pictures only.
R2_PUBLIC_BUCKET_NAME=
R2_PUBLIC_URL=

# Monitoring: Prometheus sends this as "Authorization: Bearer <token>" to /metrics.
# Production with no token serves no metrics at all. Generate one: openssl rand -hex 32
METRICS_TOKEN=

# Docker network shared with Caddy (the reverse proxy). Create it once: docker network create caddy
CADDY_NETWORK=caddy

# Backend Configuration
BACKEND_PORT=8080
CORS_ORIGIN=http://localhost:3003
FRONTEND_URL=http://localhost:3003
BACKEND_URL=http://localhost:8080

# JWT Secrets
ACCESS_TOKEN_SECRET=dev_access_secret_change_in_production_1234567890
REFRESH_TOKEN_SECRET=dev_refresh_secret_change_in_production_1234567890
FORGOT_PASSWORD_TOKEN_SECRET=dev_forgot_secret_change_in_production_1234567890
TOKEN_EXPIRY_SECONDS=900

# Mail Configuration (Optional)
GMAIL_USER=
GMAIL_APP_PASSWORD=
MAIL_FROM=

# Frontend Configuration
FRONTEND_PORT=3003
NEXT_PUBLIC_API_URL=http://localhost:8080
