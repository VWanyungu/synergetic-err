# Environment (development | staging | production)
NODE_ENV=development

# Database Configuration
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=err-syn

# ---------------------------------------------------------
# Cache: Upstash (Dev / Staging) vs Local Redis (Production)
# ---------------------------------------------------------

# Production: Local Redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PASSWORD=

# Development / Staging: Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------
# Storage: Cloudinary (Dev / Staging) vs Cloudflare R2 (Production)
# ---------------------------------------------------------

# Development / Staging: Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Production: Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Backend Configuration
BACKEND_PORT=8080
CORS_ORIGIN=http://localhost:3003
FRONTEND_URL=http://localhost:3003
BACKEND_URL=http://localhost:8080

# JWT Secrets
ACCESS_TOKEN_SECRET=dev_access_secret_change_in_production_1234567890
REFRESH_TOKEN_SECRET=dev_refresh_secret_change_in_production_1234567890
FORGOT_PASSWORD_TOKEN_SECRET=dev_forgot_secret_change_in_production_1234567890
TOKEN_EXPIRY_SECONDS=900

# Mail Configuration (Optional)
GMAIL_USER=
GMAIL_APP_PASSWORD=
MAIL_FROM=

# Frontend Configuration
FRONTEND_PORT=3003
NEXT_PUBLIC_API_URL=http://localhost:8080
