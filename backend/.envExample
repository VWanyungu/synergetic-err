NODE_ENV=development # development | staging | production
PORT=8080
CORS_ORIGIN=http://localhost:3003

# Development Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=err-syn

# Staging Database
STAGING_DB_HOST=
STAGING_DB_PORT=
STAGING_DB_USER=
STAGING_DB_PASSWORD=
STAGING_DB_NAME=

# Production Database
PROD_DB_HOST=
PROD_DB_PORT=
PROD_DB_USER=
PROD_DB_PASSWORD=
PROD_DB_NAME=

# ---------------------------------------------------------
# Cache: Upstash (Dev / Staging) vs Local Redis (Production)
# ---------------------------------------------------------

# Development / Staging: Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Production: Local Redis
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

TOKEN_EXPIRY_SECONDS=900

# ---------------------------------------------------------
# Storage: Cloudinary (Dev / Staging) vs Cloudflare R2 (Production)
# ---------------------------------------------------------

# Development / Staging: Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Production: Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# ---------------------------------------------------------
# Security & Auth Tokens
# ---------------------------------------------------------
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
FORGOT_PASSWORD_TOKEN_SECRET=

FRONTEND_URL=http://localhost:3003
BACKEND_URL=http://localhost:8080

# Mail Configuration
GMAIL_USER=
GMAIL_APP_PASSWORD=
MAIL_FROM=
